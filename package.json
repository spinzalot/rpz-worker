    "kysely": "^0.29.9",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.166.0"
  },
  "type": "module",
  "private": true
}
